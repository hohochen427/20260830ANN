# ──────────────────────────────────────────────────────────
# 段落配圖：影像生成 API 設定
#
# 用法：
#   1. cp .env.example .env
#   2. 編輯 .env，把金鑰貼進 IMAGE_API_KEY
#   3. python3 scripts/generate_images.py
#
# .env 已被 .gitignore 排除，金鑰不會進版控。
# 本檔是會進版控的範本，不要把金鑰填在這裡。
# ──────────────────────────────────────────────────────────

# ↓↓↓ 只有這一行需要你填 ↓↓↓
# OpenAI 的 API key，sk- 開頭。
# 到 platform.openai.com 的 API keys 頁面建立一把，整串貼在等號後面，不要加引號。
IMAGE_API_KEY=

# 供應商。預設 openai，也就是 OpenAI 的 GPT Image。
# 其他可選：google | stability | replicate
IMAGE_PROVIDER=openai

# 模型。留空等於 gpt-image-1。
# 這一格的字串會原樣送給 OpenAI，要換模型直接填模型代號即可：
#   gpt-image-1   留空時的預設，OpenAI GPT Image 系列
#   dall-e-3      帳號尚未完成組織驗證、呼叫拿到 403 時改填這個
# OpenAI 之後推出新版 GPT Image，把新的模型代號填進來就能直接用，不必改程式。
IMAGE_MODEL=
