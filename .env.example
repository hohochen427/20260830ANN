# 影像生成 API 設定
# 用法：複製本檔為 .env，填入你自己的金鑰。.env 已被 .gitignore 排除，不會進版控。
#   cp .env.example .env

# 供應商：openai | google | stability | replicate
IMAGE_PROVIDER=

# 你的 API 金鑰（填在這裡，不要填進 .env.example）
IMAGE_API_KEY=

# 模型名稱。留空則用該供應商的預設值
#   openai      預設 gpt-image-1
#   google      預設 imagen-3.0-generate-002
#   stability   預設 sd3.5-large
#   replicate   需填完整 owner/model:version
IMAGE_MODEL=

# 輸出尺寸，長邊像素。網頁用 1024 就夠
IMAGE_SIZE=1024
